@startuml Unified_Plugin_Engine_Architecture
skinparam componentStyle uml2
skinparam classAttributeIconSize 0

' ==========================================
' Host Engine & Process Management Layer
' ==========================================
package "Engine Host Layer (Main Process)" {

    class Loader {
        + {static} HOST : str = "localhost"
        - {static} _func_to_plugin : dict
        - {static} _loaded : dict
        + {static} load_plugin(plugin_filename: str, host: str) : contextmanager
        + {static} unload_plugin(plugin_filename: str) : void
        - {static} _wait_until_ready(host: str, port: int, timeout: int) : void
    }

    class ProxyWrapper {
        - _proxy : _Proxy
        + __getattr__(name: str) : Any
    }

    class _Proxy {
        + host : str
        + port : int
        + __init__(host: str, port: int)
        + __getattr__(name: str) : Any
    }

    ProxyWrapper *-- _Proxy : "wraps >"
    Loader ..> ProxyWrapper : "yields on dynamic load >"
}

' ==========================================
' gRPC Infrastructure / Transport
' ==========================================
package "gRPC Transport Layer" {
    class PluginServiceStub {
        + GetManifest(request: GetManifestRequest, timeout: float) : GetManifestResponse
        + ExecuteFunction(request: ExecuteRequest) : ExecuteResponse
    }

    class GetManifestRequest {}
    class GetManifestResponse {
        + manifest_json : str
    }

    PluginServiceStub ..> GetManifestRequest
    PluginServiceStub ..> GetManifestResponse
    Loader ..> PluginServiceStub : "health check & RPC >"
}

' ==========================================
' Generic Plugin Framework & Schemas
' ==========================================
package "Pydantic Schemas & Manifest Engine" {
    abstract class BaseModel {
        + model_dump() : dict
        + model_dump_json() : str
    }

    class FunctionManifestSchema {
        + parameters : Map<String, String>
        + return_type : String
    }

    class PluginManifestSchema {
        + plugin_name : String
        + functions : Map<String, FunctionManifestSchema>
    }

    abstract class BaseInputSchema {
        ' Abstract schema for all function inputs
    }

    abstract class BaseOutputSchema {
        ' Abstract schema for all function return values
    }

    BaseModel <|-- PluginManifestSchema
    BaseModel <|-- FunctionManifestSchema
    BaseModel <|-- BaseInputSchema
    BaseModel <|-- BaseOutputSchema
    PluginManifestSchema *-- FunctionManifestSchema
}

' ==========================================
' Plugin Runtime (Child Process Domain)
' ==========================================
package "Plugin Runtime (Child Process Domain)" {

    interface IPlugin {
        + get_manifest() : str
        +{abstract} ping() : str
    }

    abstract class BasePlugin {
        # EXCLUDED_METHODS : Set<String> = {"get_manifest"}
        + get_manifest() : str
        +{abstract} ping() : str
        #{static} _get_local_ip() : str
    }

    IPlugin <|.. BasePlugin

    class ConcretePluginManager {
        # EXCLUDED_METHODS : Set<String>
        +{static} ping() : str
        +{static} add(a: float, b: float) : float
        +{static} sub(a: float, b: float) : float
        +{static} multiply(a: float, b: float) : ConcreteOutputSchema
        +{static} div(a: float, b: float) : float
    }

    BasePlugin <|-- ConcretePluginManager
}

package "Python Reflection" {
    class inspect {
        +{static} getmembers()
        +{static} signature()
    }
}

' ==========================================
' Cross-Package Relationships
' ==========================================
Loader ..> BasePlugin : "spawns runtime child process >"
BasePlugin ..> inspect : "introspects signatures >"
BasePlugin ..> PluginManifestSchema : "serializes JSON manifest >"

ConcretePluginManager ..> BaseInputSchema : "validates inputs"
ConcretePluginManager ..> BaseOutputSchema : "validates outputs"

note top of Loader
  מנהל את לייף-סייקל ה-Plugins:
  1. מוצא פורט פנוי ופותח תהליך בן (Child Process).
  2. ממתין לשרת gRPC שיהיה מוכן.
  3. מחזיר ProxyWrapper שמתרגם קריאות מתודה ל-gRPC.
end note

note bottom of ConcretePluginManager
  רע ברקע בתהליך הילד:
  - מחוייב לממש את ping() המחזיר IP.
  - משתמש ב-Pydantic לאימות תקינות קלטים ופלטים.
  - מייצא מניפסט דרך get_manifest() באמצעות inspect ו-Pydantic JSON.
end note

@enduml