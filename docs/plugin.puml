@startuml plugin

abstract class BasePlugin {
  + get_manifest(): str
  + {static} ping(): str
}

class StrictBaseModel

class PingOutput {
  + response: str
}

StrictBaseModel <|-- PingOutput
BasePlugin ..> PingOutput : ping() returns

note right of BasePlugin
  Every plugin must subclass this
  and implement get_manifest().
  Plugin-specific inputs/outputs
  should extend StrictBaseModel.
end note

class PluginManager <<per-plugin implementation>> {
  + get_manifest(): str
  + <plugin functions...>
}

BasePlugin <|-- PluginManager

@enduml
