@startuml Engine_Architecture_Diagram

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

package "Plugin Loader & Lifecycle" {
    class Loader {
        + {static} HOST : str = "localhost"
        - {static} _func_to_plugin : dict
        - {static} _loaded : dict
        + {static} load_plugin(plugin_filename: str, host: str = None) : contextmanager
        + {static} unload_plugin(plugin_filename: str) : void
        - {static} _wait_until_ready(host: str, port: int, timeout: int = 5) : void
    }
}

package "Proxy & Remote Execution" {
    class ProxyWrapper {
        - _proxy : _Proxy
        + __getattr__(name: str) : Any
    }

    class _Proxy {
        + host : str
        + port : int
        + __init__(host: str, port: int)
    }
    
    ProxyWrapper *-- _Proxy : "wraps >"
}

package "gRPC Generated Layer" {
    class PluginServiceStub {
        + GetManifest(request: GetManifestRequest, timeout: float) : GetManifestResponse
    }
    class GetManifestRequest {
    }
}

package "Plugin Runtime (Child Process)" {
    class PluginManager {
        + get_manifest() : str
        + {static} ping() : str
        + {static} add(a: float, b: float) : float
        + {static} sub(a: float, b: float) : float
        + {static} multiply(a: float, b: float) : MultiplyOutput
        + {static} pow(a: float, b: float) : float
        + {static} div(a: float, b: float) : float
    }

    class MultiplyOutput {
        + result : float
    }
    
    PluginManager ..> MultiplyOutput : "uses"
}

' Relations and Interactions
Loader ..> ProxyWrapper : "yields >"
Loader ..> PluginManager : "inspects via reflection"
Loader ..> PluginServiceStub : "polls healthcheck on >"
Loader ..> multiprocessing.Process : "spawns process for run_plugin_server"

note top of Loader
  Manages dynamic plugin lifecycle 
  via background processes and 
  free port discovery.
end note

note bottom of PluginManager
  Runs inside the spawned child process 
  using Pydantic @validate_call 
  for runtime constraints.
end note

@endum
